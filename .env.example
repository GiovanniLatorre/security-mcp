# Splunk Cloud API (required for Splunk tools)
SPLUNK_BASE_URL=https://your-org.splunkcloud.com:8089
SPLUNK_TOKEN=<YOUR_SPLUNK_TOKEN>
# OR use username/password (service account, not SSO):
# SPLUNK_USERNAME=<SERVICE_ACCOUNT_USER>
# SPLUNK_PASSWORD=<SERVICE_ACCOUNT_PASS>

# Slack webhook for posture notifications (orchestrator.py --slack)
SLACK_WEBHOOK_URL=<YOUR_SLACK_WEBHOOK_URL>

# Optional: default AWS profile for deploy_wazuh security account
# WAZUH_SECURITY_PROFILE=readonly@your-org-security
